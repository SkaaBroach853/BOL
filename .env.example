# All variables are SERVER ONLY. Never prefix keys with VITE_.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/bol.sqlite
ENTRY_LIMIT_PAISE=1000000
PROPOSAL_TTL_SECONDS=300
# Optional: real voice and model interpretation. Manual entry needs no credentials.
VOICE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_INTENT_MODEL=gpt-4.1-mini
PROVIDER_TIMEOUT_MS=30000
