# Local-only BOL. No cloud key, account, or hosted AI service is used.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/bol.sqlite
ENTRY_LIMIT_PAISE=1000000
PROPOSAL_TTL_SECONDS=300
# Optional overrides; defaults are installed by npm run setup:local.
# LOCAL_PYTHON=.venv/Scripts/python.exe
LOCAL_WHISPER_MODEL=./models/whisper-base
LOCAL_SPEECH_TIMEOUT_MS=120000
